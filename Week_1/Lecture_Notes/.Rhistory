square <- function(x) {
result <- x^2
return(result)
}
# Test the function
square(4)  # Output: 16
square(7)  # Output: 49
myfun2 <- function(num1, num2){
num3 <- num1 + num2
return(num3)
}
# call the function
myfun2(num1 = 10, num2 = 11)
